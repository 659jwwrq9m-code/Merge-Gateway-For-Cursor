# Environment for merge-gateway-shim.
#
# Copy this file to `.env` (same directory) and fill in your key:
#
#     cp .env.example .env
#
# `.env` is gitignored. This template is committed, so never put a real key here.
#
# Precedence, highest first: command-line flags, then variables already exported
# in your shell, then this file, then built-in defaults. A variable you export
# for a single run therefore wins without editing this file.

# ---------------------------------------------------------------------------
# Merge Gateway
# ---------------------------------------------------------------------------

# Required for the shim to forward requests to Gateway.
# Get one from https://dashboard.merge.dev (or mint one via the Management API).
# An organization key works everywhere; a project key also scopes every request
# to that project so its routing policy and budget apply automatically.
MERGE_GATEWAY_API_KEY=

# Optional: Gateway base URL. This is Gateway's OpenAI-compatible surface, which
# is what Cursor's "Override OpenAI Base URL" expects. Only change it to target
# a different OpenAI-compatible upstream.
# MERGE_GATEWAY_BASE_URL=https://api-gateway.merge.dev/v1/openai

# Optional: attributes usage and cost to a specific Gateway project.
# MERGE_GATEWAY_PROJECT_ID=

# ---------------------------------------------------------------------------
# Shim server (all optional)
# ---------------------------------------------------------------------------

# Address and port the shim listens on. Cursor's base URL must point here.
# The default is loopback-only; see SHIM_HOST notes in the README before
# binding anything else, because the shim forwards your Gateway key.
# SHIM_HOST=127.0.0.1
# SHIM_PORT=8787

# Fallback model id, used only when Cursor sends no model in the request body.
# Gateway ids take the form `provider/model`.
# SHIM_MODEL=anthropic/claude-opus-5

# Where raw request/response captures are written. Relative paths resolve
# against the project root.
# SHIM_CAPTURE_DIR=captures

# Capture traffic to disk. Defaults to on, because the first job is working out
# what Cursor actually sends. Set to 0 once the traffic shape is understood.
# SHIM_CAPTURE=1

# Forward captured requests on to Gateway. Defaults to OFF so that capture mode
# cannot spend money or touch your Gateway account. Turn this on once you have a
# capture and want to test end to end.
# SHIM_PASSTHROUGH=0

# Offer only models that support tool calling. On by default: the picker in
# Cursor and Xcode is otherwise mostly models that answer one turn and then
# stall when the agent tries to call a tool. The list is built by joining
# Gateway's OpenAI surface (ids) with its native catalogue (capabilities).
# Set to 0 to advertise all ~273 models unfiltered.
# SHIM_FILTER_MODELS=1

# Cap on a buffered request body. Accepts a plain byte count, or megabytes via
# SHIM_MAX_BODY_MB (which wins if both are set).
# SHIM_MAX_BODY_BYTES=67108864
# SHIM_MAX_BODY_MB=64

# Suppress per-request console lines. Captures are still written.
# SHIM_QUIET=0

# Verbose diagnostics on stderr.
# SHIM_DEBUG=1
